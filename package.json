{
  "name": "homepage",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./src/tailwind.css -o ./tailwind.css --minify",
    "check:js": "find src/js -name '*.js' -print0 | xargs -0 -n1 sh -c 'node --input-type=module --check < \"$0\"'",
    "validate": "npm run check:js && npm run build:css && git diff --exit-code -- tailwind.css"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
